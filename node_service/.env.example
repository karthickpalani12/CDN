# Node.js Server Port
PORT=3000

# Cloudflare API Credentials (for programmatic cache purging)
# Found in: Cloudflare Dashboard > Overview > API section (Right sidebar)
CLOUDFLARE_ZONE_ID=your_zone_id_here

# Created in: Cloudflare Dashboard > My Profile > API Tokens > Create Token > "Purge Cache" template
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Public Domain routed through Cloudflare (e.g., https://media.yourdomain.com)
PUBLIC_CDN_URL=https://media.yourdomain.com

